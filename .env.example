# 이 파일을 .env 로 복사해 값을 채운다.
# 🔴 .env 자체는 커밋하지 않는다. Claude 는 .env 를 직접 쓰지 않는다 — 사용자가 채운다.
# 각 값의 뜻과 기본값은 docs/DATA_CONTRACT.md §9 에 있다.
#
# ⚠️ 여기 적힌 이름과 «코드가 실제로 읽는 이름»이 어긋나면, 값을 채워도 조용히 무시된다.
#    그 어긋남은 checkEnvNames 가 막는다 — 2026-09-16 에 실제로 넷이 어긋나 있었다.

# ── LLM ──────────────────────────────────────────────────────────────────────
# 🔴 진단을 부르려면 이게 있어야 한다. 없으면 진단을 «건너뛰지 않고 멈춘다» —
#    「키가 없다」와 「고칠 게 없다」는 다른 사실이다.
LLM_API_KEY=

# OpenAI 호환 엔드포인트. 끝의 / 는 있어도 없어도 된다.
#   Gemini (Google AI Studio):  https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI:                     https://api.openai.com/v1/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

HINDSIGHT_LLM_MAX_ATTEMPTS=3

# 🔴 기록 하나당 비용 상한(달러). 「돈이 떨어져 멈췄다」와 「못 고쳤다」를 다르게 적는다.
HINDSIGHT_LLM_MAX_USD=1.0

# 100만 토큰당 달러.
#
# 🔴 «비워 두면 「모른다」»이고, 모르면 한 번 부른 뒤 멈춘다 —
#    모르는 비용을 0 으로 치면 상한이 없는 것과 같아지기 때문이다.
#    그래서 «코드의» 기본값은 지금도 「모른다」다. 아래 0 은 이 파일에만 적힌 값이다.
#
# ⚠️ 아래 0 은 「Google AI Studio 무료 등급」 기준이다. 그건 추측이 아니라 사실이지만,
#    «조건이 붙은» 사실이다:
#      · 무료 한도를 넘겨 유료로 넘어가면 0 은 «거짓»이 되고, 그 순간 상한이 상한이 아니게 된다
#      · 모델을 바꾸면 값이 달라진다
#    🔴 유료로 쓰기 시작하면 «반드시» 그 모델의 가격표를 보고 여기를 고친다.
HINDSIGHT_LLM_USD_PER_MTOK_IN=0
HINDSIGHT_LLM_USD_PER_MTOK_OUT=0

# ── PR 올리기 ────────────────────────────────────────────────────────────────
# 🔴 없으면 «연습만» 한다 — 명령을 하나도 안 부른다. 「토큰이 없다」와 「올렸다」는 다르다.
#    gh 로그인이 아니라 이 토큰을 쓴다. gh 는 브라우저 로그인이 필요해 사람 없이 못 끝낸다.
GITHUB_TOKEN=

# owner/repo. PR 을 여기에 연다.
HINDSIGHT_GITHUB_REPO=
# PR 을 받을 브랜치.
HINDSIGHT_GITHUB_BASE=dev

# ── 가명화 ───────────────────────────────────────────────────────────────────
# 개인정보를 가짜 값으로 바꿀 때 쓰는 비밀키.
# 🔴 없으면 가명화 대상 필드를 통째로 버린다 (원본을 그대로 쓰지 않는다).
HINDSIGHT_PSEUDONYM_KEY=

# 🔴 LLM 이 고칠 수 있는 경로. 여기 없는 경로를 건드린 패치는 버린다.
#    src/test/** 와 기록 파일은 절대 넣지 않는다 — 채점표를 고쳐 통과시키는 것을 막는 장치다.
HINDSIGHT_PATCH_ALLOWED_PATHS=src/main/java/

# ── 에이전트 상한 ────────────────────────────────────────────────────────────
HINDSIGHT_WINDOW_SECONDS=60
HINDSIGHT_BUFFER_MAX_BYTES=33554432
HINDSIGHT_BODY_MAX_BYTES=65536
HINDSIGHT_SQL_ROWS_MAX=100
HINDSIGHT_SQL_REPEAT_FULL=3
HINDSIGHT_CAPTURES_PER_HOUR=20
HINDSIGHT_STORE_MAX_BYTES=1073741824
HINDSIGHT_LATENCY_TRIGGER_MS=3000
HINDSIGHT_AGENT_ERROR_LIMIT=50

# ── 저장 위치와 이름 ─────────────────────────────────────────────────────────
# ⚠️ 2026-09-16 까지 여기가 HINDSIGHT_RECORDINGS_DIR 로 적혀 있었다.
#    코드는 HINDSIGHT_STORE_DIR 을 읽으므로, 채워도 «아무 일도 안 일어났다».
HINDSIGHT_STORE_DIR=./recordings

# 기록에 적히는 앱 이름.
HINDSIGHT_APP_NAME=demo-app
