# 이 파일을 .env 로 복사해 값을 채운다.
# 🔴 .env 자체는 커밋하지 않는다. Claude 는 .env 를 직접 쓰지 않는다 — 사용자가 채운다.
# 각 값의 뜻과 기본값은 docs/DATA_CONTRACT.md §9 에 있다.

# ── 가명화 ───────────────────────────────────────────────────────────────────
# 개인정보를 가짜 값으로 바꿀 때 쓰는 비밀키.
# 🔴 없으면 가명화 대상 필드를 통째로 버린다 (원본을 그대로 쓰지 않는다).
HINDSIGHT_PSEUDONYM_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────────
# v2 부터 필요. v0·v1 에서는 비워 둬도 된다.
ANTHROPIC_API_KEY=
HINDSIGHT_LLM_MODEL=claude-sonnet-5
HINDSIGHT_LLM_MAX_ATTEMPTS=3

# 🔴 LLM 이 고칠 수 있는 경로. 여기 없는 경로를 건드린 패치는 버린다.
#    src/test/** 와 기록 파일은 절대 넣지 않는다 — 채점표를 고쳐 통과시키는 것을 막는 장치다.
HINDSIGHT_PATCH_ALLOWED_PATHS=src/main/**

# ── 에이전트 상한 ────────────────────────────────────────────────────────────
HINDSIGHT_WINDOW_SECONDS=60
HINDSIGHT_BUFFER_MAX_BYTES=33554432
HINDSIGHT_BODY_MAX_BYTES=65536
HINDSIGHT_SQL_ROWS_MAX=100
HINDSIGHT_SQL_REPEAT_FULL=3
HINDSIGHT_CAPTURES_PER_HOUR=20
HINDSIGHT_STORE_MAX_BYTES=1073741824
HINDSIGHT_LATENCY_TRIGGER_MS=3000
HINDSIGHT_AGENT_ERROR_LIMIT=50

# ── 저장 위치 ────────────────────────────────────────────────────────────────
HINDSIGHT_RECORDINGS_DIR=./recordings
